<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless wrapper around Quantum's .qtn code generator (normally run inside the Unity editor). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK ships an older FSharp.Core than Quantum.CodeGen.Qtn.dll binds to. -->
    <PackageReference Include="FSharp.Core" Version="8.0.400" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(QuantumSdkDir)/Editor/Assemblies/Quantum.CodeGen.Qtn.dll" />
    <Reference Include="$(QuantumSdkDir)/Editor/Assemblies/System.CodeDom.dll" />
    <Reference Include="$(QuantumLibDir)/Quantum.Engine.dll" />
    <Reference Include="$(QuantumLibDir)/Quantum.Deterministic.dll" />
    <Reference Include="$(QuantumLibDir)/Quantum.Log.dll" />
    <Reference Include="$(QuantumLibDir)/Quantum.Json.dll" />
  </ItemGroup>
</Project>
