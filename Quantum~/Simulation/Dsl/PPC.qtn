// Physics Player Controller — simulation state.
// The package never defines `input`; Quantum allows only one per game. Games feed PPCInput through
// PPCInputBridge (see PPCInputBridge.cs) or write PPCCharacter.Input directly (e.g. bots).

enum PPCState {
  Idle,
  Walking,
  Running,
  Crouching,
  Sliding,
  Jumping,
  Falling,
  Climbing
}

// Control input for one tick. Buttons are held state; systems detect presses by comparing with the
// previous tick.
struct PPCInput {
  FPVector2 Move;      // x = right, y = forward (camera-relative), length <= 1
  FP LookYaw;          // camera yaw in degrees (world space)
  FP LookPitch;        // camera pitch in degrees, positive = looking up
  Boolean Jump;
  Boolean Run;
  Boolean Crouch;
}

// Probe results (PPCProbeSystem). IsGrounded is the one "grounded" every system uses: it is off from
// the tick the character jumps or is launched until it stops rising, even while the probe still
// reaches the floor.
struct PPCGroundInfo {
  Boolean IsGrounded;
  Boolean WasGrounded;
  FPVector3 Normal;
  FP SlopeAngle;
  FP Gap;                      // distance from the capsule bottom down to the ground
  EntityRef Entity;
  Boolean IsCeilingBlocked;
  Boolean IsTouchingWall;
  FPVector3 WallNormal;
}

// Horizontal velocity layer (PPCMovementLayerSystem).
struct PPCHorizontalLayer {
  FPVector3 Current;           // player-driven horizontal velocity
  FPVector3 External;          // absorbed external horizontal velocity (explosions, pushes)
  FPVector3 Contribution;      // this layer's velocity this tick (read back next tick to detect external forces)
}

// Vertical velocity layer (PPCVerticalLayerSystem).
struct PPCVerticalLayer {
  FP AccumulatedY;
  FP PlatformY;
  FP LastPlatformY;
  FP TargetY;                  // this layer's vertical velocity this tick (read back next tick, like Contribution)
}

struct PPCJumpState {
  FP BufferTimer;
  FP CoyoteTimer;
  Boolean IsJumping;
  Boolean JumpedThisTick;
}

struct PPCCrouchState {
  Boolean IsCrouching;
}

// Exclusive climb layer (PPCClimbSystem): while climbing it replaces all other layers.
struct PPCClimbState {
  Boolean IsClimbing;
  EntityRef Ladder;
  FPVector3 Velocity;
  EntityRef Released;          // ladder just let go of; not re-grabbed until the character leaves it
}

struct PPCPlatformState {
  EntityRef Entity;            // what the ground probe sees (tracked even while airborne)
  FPVector3 PreviousPosition;
  FPQuaternion PreviousRotation;
  FPVector3 GroundVelocity;    // velocity of that ground under the character, grounded or not
  FPVector3 BaseVelocity;      // GroundVelocity while grounded (the carry), else zero
  FP YawDelta;                 // platform yaw change this tick (degrees), for the camera
}

component PPCCharacter {
  AssetRef<PPCConfig> Config;
  [ExcludeFromPrototype] PPCInput Input;
  [ExcludeFromPrototype] PPCInput PreviousInput;
  [ExcludeFromPrototype] PPCState State;
  [ExcludeFromPrototype] PPCGroundInfo Ground;
  [ExcludeFromPrototype] PPCHorizontalLayer Horizontal;
  [ExcludeFromPrototype] PPCVerticalLayer Vertical;
  [ExcludeFromPrototype] PPCJumpState Jump;
  [ExcludeFromPrototype] PPCCrouchState Crouch;
  [ExcludeFromPrototype] PPCClimbState Climb;
  [ExcludeFromPrototype] PPCPlatformState Platform;
  [ExcludeFromPrototype] FPVector3 TargetVelocity;   // final velocity the body was driven towards
}

// Shared per-game controller data (created on demand by PPCSetupSystem).
singleton component PPCShared {
  AssetRef<PhysicsMaterial> FrictionlessMaterial;
}

// Links a character to the player whose input drives it.
component PPCPlayerLink {
  PlayerRef Player;
}

// Marks a trigger collider as a ladder (PPCClimbSystem).
component PPCLadder {
}

event PPCJumped {
  EntityRef Entity;
}

event PPCLanded {
  EntityRef Entity;
  FP ImpactSpeed;
}

event PPCCrouchChanged {
  EntityRef Entity;
  Boolean IsCrouching;
}

event PPCClimbStarted {
  EntityRef Entity;
  EntityRef Ladder;
}

event PPCClimbEnded {
  EntityRef Entity;
}
